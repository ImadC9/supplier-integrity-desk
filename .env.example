# Optional settings. Set them in your shell, your container runtime or your
# host's secrets manager. The app does not read this file automatically.

# AI explanations in the Investigation view (optional; offline rules are the default).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Where completed review decisions are stored (default: ./outputs/reviews.sqlite3).
SUPPLIER_REVIEW_DB=

# Folder of Markdown policies that replaces the bundled fictional ones.
SUPPLIER_DESK_POLICY_DIR=

# Default database connection for the app and `supplier-desk --db` (SQLite path or SQLAlchemy URL).
SUPPLIER_DESK_DB_URL=

# Interface language: en or es (default: the browser language).
SUPPLIER_DESK_LANG=

# Cache for the optional local embedding model (default: ~/.cache/supplier-integrity-desk/models).
SUPPLIER_DESK_MODEL_CACHE=
